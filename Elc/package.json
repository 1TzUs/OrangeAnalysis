{
  "name": "battle-report-elc",
  "version": "1.0.0",
  "description": "战报分析 - Electron 桌面壳",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "dev": "cross-env ELC_DEV=1 electron .",
    "prepare": "node scripts/prepare-res.cjs",
    "dist": "npm run prepare && electron-builder --win portable"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.orange.battlereport",
    "productName": "战报分析",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.cjs"
    ],
    "extraResources": [
      {
        "from": "res/web",
        "to": "web"
      },
      {
        "from": "res/ocr",
        "to": "ocr"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "战报分析-setup.${ext}",
      "signAndEditExecutable": false
    }
  }
}